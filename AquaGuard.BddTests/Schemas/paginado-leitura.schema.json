{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["page", "pageSize", "totalRecords", "totalPages", "data"],
  "properties": {
    "page": { "type": "integer" },
    "pageSize": { "type": "integer" },
    "totalRecords": { "type": "integer" },
    "totalPages": { "type": "integer" },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "medidorId", "codigoMedidor", "litrosConsumidos", "dataLeitura", "usuarioId", "nomeUsuario"],
        "properties": {
          "id": { "type": "integer" },
          "medidorId": { "type": "integer" },
          "codigoMedidor": { "type": "string" },
          "litrosConsumidos": { "type": "number" },
          "dataLeitura": { "type": "string", "format": "date-time" },
          "usuarioId": { "type": "integer" },
          "nomeUsuario": { "type": "string" }
        }
      }
    }
  }
}
