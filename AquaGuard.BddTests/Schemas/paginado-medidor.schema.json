{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["page", "pageSize", "totalRecords", "totalPages", "data"],
  "properties": {
    "page": { "type": "integer" },
    "pageSize": { "type": "integer" },
    "totalRecords": { "type": "integer" },
    "totalPages": { "type": "integer" },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "codigo", "localizacao", "limiteMensalLitros", "ativo", "dataCriacao"],
        "properties": {
          "id": { "type": "integer" },
          "codigo": { "type": "string" },
          "localizacao": { "type": "string" },
          "limiteMensalLitros": { "type": "number" },
          "ativo": { "type": "boolean" },
          "dataCriacao": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
